# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=iem_jwt_super_secure_key_2026_admission_portal
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# MySQL Database
DB_DIALECT=sqlite
# When using MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iem_admission_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# MongoDB Database (Optional or gridfs / metadata)
MONGO_URI=mongodb://localhost:27017/iem_documents_db

# Storage Path for Uploads
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_MB=5
